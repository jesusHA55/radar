# --- Auth (invite-only) --------------------------------------------------
# Sign-in is passwordless; an invite (or an existing account) is required.
# Seed an invite for a friend as well:
# SEED_FRIEND_EMAIL=friend@example.com
# Sign-in emails reuse RESEND_API_KEY / ALERT_FROM_EMAIL; without them the
# magic link is printed to the console in development.

# --- Flight data provider -----------------------------------------------
# "mock" = deterministic offline demo data (no network, no cost).
# Switch to "airscraper" / "serpapi" once you add real credentials.
FLIGHT_PROVIDER=mock

# --- Database ------------------------------------------------------------
# The app always talks to Postgres over TCP. In production, point this at a
# hosted instance (Supabase / Neon). Locally, `npm run dev` starts an embedded
# PostgreSQL cluster on this address.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/postgres
# DATABASE_POOL_MAX=2
# POSTGRES_DATA_DIR=.data/pg

# --- Notifications (M1) --------------------------------------------------
# Leave RESEND_API_KEY unset to log alerts to the console instead of sending.
# RESEND_API_KEY=re_...
# ALERT_FROM_EMAIL=Radar <alerts@your-domain.tld>

# --- Monitoring worker ---------------------------------------------------
# Email seeded as the first local user (and invitee).
LOCAL_USER_EMAIL=you@radar.local
# Global monthly cap on upstream provider calls (quota-aware polling).
MONTHLY_CALL_BUDGET=10000
# Minimum minutes between alert emails for the same watch (anti-spam).
ALERT_COOLDOWN_MINUTES=720
# Shared secret for POST /api/cron/poll. Required in production.
# CRON_SECRET=

# --- Explore -------------------------------------------------------------
# How long a cached "everywhere" fan-out stays fresh, in seconds (default 6h).
EXPLORE_CACHE_TTL_SECONDS=21600
# CALENDAR_CACHE_TTL_SECONDS=21600

# --- Meet ----------------------------------------------------------------
# Cache lifetime for aligned per-traveller leg searches (default 30m).
MEET_CACHE_TTL_SECONDS=1800

# --- Real provider keys (when FLIGHT_PROVIDER is not "mock") -------------
# AIRSCRAPER_API_KEY=
# SERPAPI_API_KEY=

# --- Web push (M6, planned) ---------------------------------------------
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
