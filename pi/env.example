# Radar — Raspberry Pi host environment.
#
#   1. cp pi/env.example .env.local
#   2. fill in the values below
#
# The app (Next.js) and the pi/ scripts both read this file.

# --- App -----------------------------------------------------------------
NODE_ENV=production
# Change this if 3000 is already used by something else on the Pi.
PORT=3000
# Where the tunnel script writes the public URL; /settings reads it.
TUNNEL_URL_FILE=/var/lib/radar/tunnel-url.txt

# --- Database ------------------------------------------------------------
# Create the role + database with:
#   RADAR_DB_PASSWORD='a-strong-password' ./pi/postgres-setup.sh
DATABASE_URL=postgres://radar:CHANGE_ME@127.0.0.1:5432/radar
DATABASE_POOL_MAX=4

# --- Flight data provider ------------------------------------------------
# "mock" = deterministic offline demo data. Switch to "serpapi" at runtime
# from /settings, or set it here.
FLIGHT_PROVIDER=mock
MONTHLY_CALL_BUDGET=250
# SERPAPI_API_KEY=
# SERPAPI_GL=de
# SERPAPI_HL=en
# SERPAPI_CURRENCY=EUR

# --- Email (Gmail via App Password) --------------------------------------
# Enable 2-Step Verification on a Google account, create an "App Password",
# and paste it below. A dedicated/secondary account is recommended.
EMAIL_TRANSPORT=gmail
MAIL_FROM="Radar <you@gmail.com>"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=you@gmail.com
SMTP_PASS=xxxxxxxxxxxxxxxx

# --- Auth / invites ------------------------------------------------------
LOCAL_USER_EMAIL=you@gmail.com
# Max sign-in link requests per email per hour.
MAGIC_LINK_MAX_PER_HOUR=5

# --- Monitoring worker ---------------------------------------------------
CRON_SECRET=CHANGE_ME_to_a_long_random_string
ALERT_COOLDOWN_MINUTES=720
